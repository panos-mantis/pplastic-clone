        <div class="persons">
          <h3 data-i18n="contact.persons">Contact persons</h3>
          <div class="person">
            <div class="avatar" aria-hidden="true">PP</div>
            <div><div class="role" data-i18n="contact.person1.role">Sales and Customer Service</div><div class="name" data-i18n="contact.person1.name">Pavlos Papadopoulos</div></div>
          </div>
          <div class="person">
            <div class="avatar" aria-hidden="true">ΠΠ</div>
            <div><div class="role" data-i18n="contact.person2.role">Technical Dept.</div><div class="name" data-i18n="contact.person2.name">Panagiotis Papadopoulos</div></div>
          </div>
        </div>
      </div>

      <form class="form-card reveal" id="contactForm">
        <h3 data-i18n="contact.form.title">Send us a message</h3>
        <p data-i18n="contact.form.sub">Tell us about your application and we'll get back to you.</p>
        <div class="field-row">
          <div class="field"><label for="n" data-i18n="contact.form.name">Name</label><input id="n" name="name" type="text" autocomplete="name" data-i18n="contact.form.ph.name" placeholder="Your name" required></div>
          <div class="field"><label for="e" data-i18n="contact.form.email">Email</label><input id="e" name="email" type="email" autocomplete="email" data-i18n="contact.form.ph.email" placeholder="you@company.com" required></div>
        </div>
        <div class="field"><label for="p"><span data-i18n="contact.form.phone">Phone</span> <span class="opt" data-i18n="contact.form.optional">(optional)</span></label><input id="p" name="phone" type="tel" autocomplete="tel" data-i18n="contact.form.ph.phone" placeholder="+30 123 456 7890"></div>
        <div class="field"><label for="m" data-i18n="contact.form.message">Message</label><textarea id="m" name="message" rows="4" data-i18n="contact.form.ph.message" placeholder="Tell us about your profile needs…" required></textarea></div>
        <div class="hp-field" aria-hidden="true"><label for="w">Website</label><input id="w" name="website" type="text" tabindex="-1" autocomplete="off"></div>
        <button class="btn btn-primary" type="submit" style="width:100%;" data-i18n="contact.form.btn">Send message</button>
        <div class="form-status" id="formStatus" role="status" aria-live="polite"></div>
      </form>
    </div>
  </section>
