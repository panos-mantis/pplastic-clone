extraScripts: "  <!-- EmailJS SDK and form handling (version pinned so a CDN update can't break the form) -->\r\n  <script src=\"https://cdn.jsdelivr.net/npm/emailjs-com@3.2.0/dist/email.min.js\" defer></script>\r\n  <script>\r\n    document.addEventListener('DOMContentLoaded', function () {\r\n      const form = document.getElementById('contactForm');\r\n      const statusDiv = document.getElementById('formStatus');\r\n      const btn = form.querySelector('button[type=\"submit\"]');\r\n      const t = (key) => window.pplasticT ? window.pplasticT(key) : key;\r\n\r\n      const setStatus = (state, key) => {\r\n        statusDiv.className = 'form-status is-' + state;\r\n        statusDiv.textContent = t(key);\r\n      };\r\n\r\n      if (window.emailjs) emailjs.init('fOZRzhzaNJFyqAFZQ');\r\n\r\n      form.addEventListener('submit', function (e) {\r\n        e.preventDefault();\r\n        const f = form.elements;\r\n\r\n        // Honeypot: bots fill the hidden field — pretend success, send nothing\r\n        if (f.website.value) { setStatus('ok', 'contact.form.ok'); form.reset(); return; }\r\n\r\n        if (!window.emailjs) { setStatus('err', 'contact.form.err'); return; }\r\n\r\n        setStatus('pending', 'contact.form.sending');\r\n        btn.disabled = true;\r\n\r\n        const templateParams = {\r\n          name: f.name.value.trim(),\r\n          email: f.email.value.trim(),\r\n          phone: f.phone.value.trim(),\r\n          message: f.message.value.trim()\r\n        };\r\n\r\n        // EmailJS service and template configuration\r\n        emailjs.send('service_6kxvwi3', 'template_wna4bew', templateParams)\r\n          .then(() => {\r\n            setStatus('ok', 'contact.form.ok');\r\n            form.reset();\r\n          })\r\n          .catch((error) => {\r\n            console.error('EmailJS error:', error);\r\n            setStatus('err', 'contact.form.err');\r\n          })\r\n          .finally(() => { btn.disabled = false; });\r\n      });\r\n    });\r\n  </script>"
